generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model tb_usuario {
  id_usuario  Int      @id @default(autoincrement())
  url_imagem  String?
  nome        String
  email       String   @unique
  telefone    String?
  hash_senha  String
  ativo       Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
